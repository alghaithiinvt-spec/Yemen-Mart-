rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'yemen.mart.sq@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /ads/{adId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100
        && request.resource.data.images.size() <= 3;

      allow update: if request.auth != null && (
        isAdmin()
        || (resource.data.uid == request.auth.uid && resource.data.status != 'hidden')
        || (
          resource.data.type == 'auction'
          && request.time.toMillis() < resource.data.endAt
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['currentBid','bidCount','topBidderUid','topBidderName'])
          && request.resource.data.currentBid >= resource.data.currentBid
          && request.resource.data.bidCount == resource.data.bidCount + 1
          && request.resource.data.topBidderUid == request.auth.uid
        )
      );

      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid || isAdmin());

      match /bids/{bidId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['adId','adTitle','adOwnerUid','reason','note','uid','userName','createdAt','status'])
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100
        && request.resource.data.note.size() <= 300;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
